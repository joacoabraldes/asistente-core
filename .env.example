# Base de datos. El puerto 5433 es el que publica docker-compose, para no
# chocar con un Postgres local en 5432.
DATABASE_URL=postgresql+psycopg://asistente:asistente@localhost:5433/asistente
DATABASE_URL_TEST=postgresql+psycopg://asistente:asistente@localhost:5433/asistente_test

# Credenciales con las que docker-compose levanta Postgres.
POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente
POSTGRES_DB=asistente

# Servidor
APP_PORT=8000
LOG_LEVEL=INFO

# Claves de los proveedores de LLM. LiteLLM lee la que corresponda segun el
# modelo configurado en la organizacion. No hay proveedor por defecto.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Solo desarrollo: si tiene valor, el proveedor no se llama de verdad y
# responde este texto. Dejar vacia en produccion.
LLM_MOCK_RESPONSE=

# Filtro de pertinencia. Que hace cuando NO puede decidir (el proveedor falla o
# contesta en un formato inesperado): 1 deja pasar, 0 bloquea. Por defecto deja
# pasar, porque bloquear preguntas legitimas es el costo que no se ve.
SCOPE_FILTER_FAIL_OPEN=1

# Solo desarrollo: fuerza la decision del filtro sin llamar al proveedor.
# Valores utiles: PERMITIDO  /  "NO_PERMITIDO: fuera de tema"
LLM_MOCK_SCOPE_DECISION=
